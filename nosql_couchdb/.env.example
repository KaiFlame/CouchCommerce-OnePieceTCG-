# Copie para .env e substitua todos os valores SUBSTITUA por segredos aleatórios.
# Para este laboratorio, use senhas hexadecimais (sem caracteres especiais de URL).
SECRET_KEY=SUBSTITUA_POR_64_CARACTERES_HEXADECIMAIS
COUCHDB_USER=admin
COUCHDB_PASSWORD=SUBSTITUA_POR_64_CARACTERES_HEXADECIMAIS
COUCHDB_DATABASE=ecommerce_facamp
APP_COUCHDB_USER=loja_app
APP_COUCHDB_PASSWORD=SUBSTITUA_POR_64_CARACTERES_HEXADECIMAIS
# Flask local: localhost. O Compose usa o nome de servico couchdb internamente.
COUCHDB_URL=http://${APP_COUCHDB_USER}:${APP_COUCHDB_PASSWORD}@127.0.0.1:5984
# Use 1 apenas quando o site estiver atrás de HTTPS.
COOKIE_SECURE=0
