# Copie para .env e substitua os dois valores abaixo por segredos aleatorios.
# Para este laboratorio, use senhas hexadecimais (sem caracteres especiais de URL).
SECRET_KEY=SUBSTITUA_POR_64_CARACTERES_HEXADECIMAIS
COUCHDB_USER=admin
COUCHDB_PASSWORD=SUBSTITUA_POR_64_CARACTERES_HEXADECIMAIS
COUCHDB_DATABASE=ecommerce_facamp
# Flask local: localhost. O Compose usa o nome de servico couchdb internamente.
COUCHDB_URL=http://${COUCHDB_USER}:${COUCHDB_PASSWORD}@127.0.0.1:5984
